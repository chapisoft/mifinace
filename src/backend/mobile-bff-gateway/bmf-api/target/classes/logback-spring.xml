<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="bmf-mobile-bff-gateway"/>

    <!-- Appender ghi Console định dạng JSON ECS chuẩn Elastic Common Schema -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>${appName}</serviceName>
            <includeMarkers>true</includeMarkers>
            <includeOrigin>false</includeOrigin>
            <stackTraceAsTimestamp>false</stackTraceAsTimestamp>
        </encoder>
    </appender>

    <!-- Appender chuẩn hiển thị màu sắc cho môi trường Dev cục bộ -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) [%X{traceId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Mức log cho các gói hệ thống -->
    <logger name="com.bmf.mobile" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.jdbc" level="INFO"/>
    <logger name="org.redisson" level="WARN"/>
    <logger name="com.microsoft.sqlserver" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE_TEXT"/>
    </root>

</configuration>
